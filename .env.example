# SellerOS environment variables
# Copy to .env.local and fill in real values. NEVER commit .env files.
# The frontend only ever sees the PUBLISHABLE (anon) key.
# The secret/service-role key is SERVER-SIDE ONLY — it must never
# appear in Vite client code, public JSON, or this file's browser build.

# ── Supabase (client / publishable) ───────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
# (or output of `supabase start` for local development)
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# ── Edge functions (server-side only) ─────────────────────────
# These are used by supabase/functions/*. Never prefix with VITE_.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# INTEGRATION_WEBHOOK_SECRET=random-256-bit-secret
